/*
================================================================================
Development mIF imaging pipeline
================================================================================

Spatial-mIFlow/ is the pipeline itself: code only, nothing the user is expected to
edit. It sits inside a project checkout alongside sibling files that ARE
user-facing and are NOT part of the pipeline:

    <project>/
      Spatial-mIFlow/                pipeline code: main.nf, nextflow.config, modules/
      params.yml                user-facing parameters
      master_samplesheet.csv    user-facing samplesheet
      data/                     user-facing raw input images
      run_pipeline_slurm.sh     user-facing launcher (sbatch this)
      outputs/                  generated results

Rule used in this project:
- nextflow.config: output folders, resources, scratch/cache defaults, profiles.
- params.yml: user-facing scientific/runtime parameters, incl. samplesheet/outdir.
- modules/<name>/: self-contained per process (main.nf, environment.yml, any
  script/notebook it runs), referenced via ${moduleDir}, never as params.
- programs_hierarchy/ (inside Spatial-mIFlow/): shared/external assets not owned by
  a single module (the vendored nf-core/sopa sub-pipeline).

Launcher: sbatch run_pipeline_slurm.sh [-resume]
================================================================================
*/

// =============================================================================
// Required, no-default parameters
// =============================================================================
//
// `error(...)` isn't available while parsing a plain config file; throwing
// is what actually halts parsing with a clear message.

['samplesheet', 'outdir'].each { name ->
    if (!params[name]) {
        throw new IllegalArgumentException(
            "params.${name} is required -- set it in params.yml."
        )
    }
}


// =============================================================================
// Parameters kept in nextflow.config
// =============================================================================
//
// conda/singularity cache locations are set directly below (native engine
// settings, not params -- see "Cache defaults"), not through params here.
// Each pipeline stage builds its own "${params.outdir}/<subdir>" path
// directly in its own module rather than through a separate param here.

params {

    python_bin = "python3"

    // -------------------------------------------------------------------------
    // SOPA internals. User params are in params.yml:sopa / sopa_adapter.
    // -------------------------------------------------------------------------

    sopa_pipeline = "${projectDir}/programs_hierarchy/sopa_setup/external_pipelines/nf-core/sopa_dev"
    sopa_config = "${projectDir}/programs_hierarchy/sopa_setup/configs/sopa.config"

    cpu_queue = "long"
    gpu_queue = "gpu"
}


// =============================================================================
// Cache defaults
// =============================================================================
//
// Native engine settings, not params: a deployment-level ./nextflow.config
// (project root, loaded after this one) can override either directly.

conda.enabled = true
conda.cacheDir = './nextflow_conda'

singularity.enabled = true
singularity.cacheDir = './singularity'

// Python's default user-site mechanism makes every conda-based task's
// process also see ~/.local/lib/pythonX.Y/site-packages, ahead of the
// task's own conda env on sys.path -- verified this silently shadowed
// rapids_clustering_notebook's own matched rapids_singlecell/cuml with
// mismatched personal versions from the submitting user's home directory.
// Applies to every process, not just conda-based ones, but is a no-op for
// the rest.
env {
    PYTHONNOUSERSITE = '1'
}


// =============================================================================
// Global process behavior
// =============================================================================

process {

    errorStrategy = 'terminate'

    withName: PREPARE_COMPOSITE_MIP {
        cpus = 16
        memory = '128 GB'
        time = '12h'
        queue = params.cpu_queue
    }

    withName: PUBLISH_PREPARED_IMAGE {
        cpus = 1
        memory = '16 GB'
        time = '6h'
        queue = params.cpu_queue
    }

    withName: BUILD_SOPA_SAMPLESHEET {
        cpus = 1
        memory = '4 GB'
        time = '30m'
        queue = params.cpu_queue
    }

    // Outer driver only -- inner SOPA tasks are sized by
    // programs_hierarchy/sopa_setup/configs/sopa.config. Despite being a
    // thin wrapper, this task also does the inner pipeline's Singularity
    // image pulls/conversions itself (that happens in the inner Nextflow
    // driver process, a child of this task, not in the sub-jobs it
    // launches) -- verified OOM-killed at 8GB converting the -cellpose
    // image (~7GB RSS) even though the actual compute steps never touch
    // this task's memory budget.
    withName: RUN_SOPA_AND_COLLECT_ADATA {
        cpus = 1
        memory = '32 GB'
        time = '240h'
        queue = params.cpu_queue
    }

    withName: RAPIDS_CLUSTERING_NOTEBOOK {
        cpus = 4
        memory = '64 GB'
        time = '24h'
        queue = params.gpu_queue
    }

    withName: CLUSTER_EXPLORATION_NOTEBOOK {
        cpus = 4
        memory = '64 GB'
        time = '24h'
        queue = params.cpu_queue
    }

    withName: SCIMAP_AUTOGATING_NOTEBOOK {
        cpus = 4
        memory = '64 GB'
        time = '24h'
        queue = params.cpu_queue
    }

    withName: CONTINGENCY_CLUSTER_POPULATIONS_NOTEBOOK {
        cpus = 4
        memory = '64 GB'
        time = '12h'
        queue = params.cpu_queue
    }

    withName: EXPORT_SOPA_CELL_BOUNDARIES_NPZ {
        cpus = 2
        memory = '64 GB'
        time = '6h'
        queue = params.cpu_queue
    }

    withName: SPATIAL_ANALYSIS_CLUSTERS_NOTEBOOK {
        cpus = 8
        memory = '96 GB'
        time = '24h'
        queue = params.cpu_queue
    }
}


// =============================================================================
// Profiles
// =============================================================================

profiles {

    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
        process.queue = params.cpu_queue
    }
}
