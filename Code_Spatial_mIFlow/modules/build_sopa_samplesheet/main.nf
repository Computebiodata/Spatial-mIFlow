// -----------------------------------------------------------------------------
// Helper: write small generated YAML files from parsed Nextflow params
// -----------------------------------------------------------------------------

def yamlScalarForGeneratedConfig(v) {
    if (v == null) {
        return "null"
    }

    if (v instanceof Boolean || v instanceof Number) {
        return v.toString()
    }

    def s = v.toString()
        .replace("\\", "\\\\")
        .replace("\"", "\\\"")

    return "\"${s}\""
}


def yamlMapBodyForGeneratedConfig(Map m) {
    return m.collect { k, v ->
        "${k}: ${yamlScalarForGeneratedConfig(v)}"
    }.join("\n")
}


process BUILD_SOPA_SAMPLESHEET {

    tag "sopa_inputs"

    conda "${moduleDir}/environment.yml"

    publishDir "${params.outdir}/00_runtime/sopa_inputs",
        mode: 'copy',
        overwrite: true,
        failOnError: true

    input:
    path manifests

    output:
    path "sopa_samplesheet.csv", emit: sopa_samplesheet
    path "resolved_sopa_channels.json", emit: resolved_channels
    path "sopa_params.generated.yml", emit: sopa_params

    script:
    def manifest_args = manifests instanceof java.util.List
        ? manifests.collect { it.toString() }.join(' ')
        : manifests.toString()

    def sopa_user_params = new LinkedHashMap((params.sopa ?: [:]) as Map)

    /*
     * input and outdir are dynamic and must be generated by this workflow.
     * If a user accidentally puts them in configs/params.yml, ignore them here.
     */
    sopa_user_params.remove("input")
    sopa_user_params.remove("outdir")

    if (sopa_user_params.isEmpty()) {
        error "Missing or empty `sopa:` section in configs/params.yml"
    }

    def SOPA_YAML_BODY = yamlMapBodyForGeneratedConfig(sopa_user_params)
    // outdir may be relative (resolved against launchDir); both of these are
    // used as raw bash paths below (and SOPA_OUTPUT_DIR also gets written
    // into sopa_params.generated.yml as the *inner* SOPA pipeline's --outdir,
    // which needs to be correct regardless of the inner run's own launchDir),
    // so absolutize here rather than leaving it to bash.
    def ABS_OUTDIR = (params.outdir as String).startsWith('/') ? params.outdir : "${launchDir}/${params.outdir}"
    def SOPA_RUNTIME_INPUTS_DIR = "${ABS_OUTDIR}/00_runtime/sopa_inputs"
    def SOPA_OUTPUT_DIR = "${ABS_OUTDIR}/02_sopa"

    """
    set -euo pipefail

    mkdir -p "${SOPA_RUNTIME_INPUTS_DIR}"

    echo "============================================================"
    echo "BUILD SOPA RUNTIME INPUTS"
    echo "============================================================"
    echo "Runtime dir:"
    echo "${SOPA_RUNTIME_INPUTS_DIR}"
    echo "Prepared-image manifests:"
    echo "${manifest_args}"
    echo "============================================================"

    python "${moduleDir}/bin/build_sopa_samplesheet.py" \
        --prepared-manifest ${manifest_args} \
        --output sopa_samplesheet.csv \
        --resolved-channels-json resolved_sopa_channels.json \
        --required-channels "${params.sopa_adapter.required_channels}" \
        --strict

    cat > sopa_params.generated.yml <<'EOF_SOPA_PARAMS'
${SOPA_YAML_BODY}
input: "${SOPA_RUNTIME_INPUTS_DIR}/sopa_samplesheet.csv"
outdir: "${SOPA_OUTPUT_DIR}"
EOF_SOPA_PARAMS

    cp -f sopa_samplesheet.csv "${SOPA_RUNTIME_INPUTS_DIR}/sopa_samplesheet.csv"
    cp -f resolved_sopa_channels.json "${SOPA_RUNTIME_INPUTS_DIR}/resolved_sopa_channels.json"
    cp -f sopa_params.generated.yml "${SOPA_RUNTIME_INPUTS_DIR}/sopa_params.generated.yml"

    echo "Generated SOPA samplesheet:"
    cat sopa_samplesheet.csv

    echo
    echo "Generated SOPA params:"
    cat sopa_params.generated.yml

    echo
    echo "Generated runtime files:"
    ls -lh "${SOPA_RUNTIME_INPUTS_DIR}"

    echo "SOPA runtime input generation completed."
    """
}
