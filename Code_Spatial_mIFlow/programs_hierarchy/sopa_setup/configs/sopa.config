/*
================================================================================
Inner nf-core/SOPA config
================================================================================

This config is used by the inner SOPA Nextflow run launched by the global
pipeline.

No user-specific paths are hardcoded.

The outer launcher/global pipeline provides:
    TMPDIR
    MPLCONFIGDIR
    CELLPOSE_LOCAL_MODELS_PATH
    NXF_SINGULARITY_CACHEDIR

and passes:
    --cpu_queue
    --gpu_queue
================================================================================
*/

def CPU_QUEUE = params.cpu_queue ?: 'long'
def GPU_QUEUE = params.gpu_queue ?: 'gpu'

def NUMBA_CACHE = System.getenv('NUMBA_CACHE_DIR') ?: '/tmp/numba_cache'
def MPL_CACHE = System.getenv('MPLCONFIGDIR') ?: '/tmp/matplotlib'
def CELLPOSE_CACHE = System.getenv('CELLPOSE_LOCAL_MODELS_PATH') ?: "${launchDir}/cellpose_models"
def SINGULARITY_CACHE = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${launchDir}/singularity"

process {

    executor = 'slurm'
    queue = CPU_QUEUE

    withName: '.*' {
        containerOptions =
            "--env NUMBA_CACHE_DIR=${NUMBA_CACHE} " +
            "--env NUMBA_DISABLE_JIT=1 " +
            "--env MPLCONFIGDIR=${MPL_CACHE} " +
            "--env CELLPOSE_LOCAL_MODELS_PATH=${CELLPOSE_CACHE}"
    }

    withName: 'NFCORE_SOPA:SOPA:TO_SPATIALDATA' {
        queue = CPU_QUEUE
        cpus = 8
        memory = 128.GB
        time = '24h'
    }

    withName: 'NFCORE_SOPA:SOPA:MAKE_IMAGE_PATCHES' {
        queue = CPU_QUEUE
        cpus = 4
        memory = 32.GB
        time = '6h'
    }

    withName: '.*CELLPOSE.*' {
        queue = GPU_QUEUE
        cpus = 4
        // Host RAM, not VRAM (GPU memory is separate -- see maxForks comment
        // below). Real peak RSS across 196 patches in a completed run never
        // exceeded 3.5GB; this leaves ~2.3x headroom, backed by the retry
        // policy below for any denser-than-usual patch.
        memory = 8.GB
        time = '24h'

        containerOptions =
            "--nv " +
            "--env NUMBA_CACHE_DIR=${NUMBA_CACHE} " +
            "--env NUMBA_DISABLE_JIT=1 " +
            "--env MPLCONFIGDIR=${MPL_CACHE} " +
            "--env CELLPOSE_LOCAL_MODELS_PATH=${CELLPOSE_CACHE}"
            
        maxForks = (params.cellpose_max_forks ?: 4)
        errorStrategy = 'retry'
        maxRetries = 3
    }

    withName: 'NFCORE_SOPA:SOPA:AGGREGATE' {
        queue = CPU_QUEUE
        cpus = 8
        memory = 128.GB
        time = '24h'
    }
}

singularity {
    enabled = true
    cacheDir = SINGULARITY_CACHE
    runOptions = '--nv'
}
